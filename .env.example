# CodeLens AI configuration. Every value below is OPTIONAL.
# With none of them set, CodeLens runs fully offline with deterministic analysis only.

# --- AI semantic layer (Layer C). Default: disabled. ---
# none   = deterministic analysis only (default, $0, fully offline)
# ollama = local model via Ollama, free, no data leaves the machine
# anthropic / openai = BYO key. YOU are billed by the provider. Opt-in only.
CODELENS_AI_PROVIDER=none
CODELENS_AI_MODEL=
CODELENS_OLLAMA_URL=http://127.0.0.1:11434
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Hard ceiling on AI tokens per scan. The scan aborts Layer C rather than exceeding it.
CODELENS_AI_TOKEN_BUDGET=120000

# --- Authentication (web application) ---
# Signs session cookies and encrypts stored provider tokens. 32+ characters.
# Without it the web app refuses to issue sessions rather than signing with a
# weak or absent key, and provider tokens cannot be stored at all.
CODELENS_SECRET_KEY=

# --- Storage ---
CODELENS_HOME=.codelens
CODELENS_RETENTION_DAYS=30

# --- GitHub ingestion (read-only scopes only) ---
# GITHUB_TOKEN=

# --- Layer D dynamic verification. Default: disabled. See docs/LIMITATIONS.md. ---
# Without container isolation this machine CANNOT safely execute untrusted code.
CODELENS_DYNAMIC_VERIFY=off

# --- Billing. Default: disabled; every account stays on the free plan. ---
# none   = no payments. The product runs in full; plan limits still apply.
# stripe = Stripe Checkout + webhooks.
CODELENS_PAYMENT_PROVIDER=none
# STRIPE_SECRET_KEY=
# Mandatory when the provider is stripe: without it the app refuses to run
# billing at all, because entitlements would rest on an unverified request.
# STRIPE_WEBHOOK_SECRET=
# One price id per plan or credit-pack code, upper-cased. The codes are the
# ones in DEFAULT_PLANS and DEFAULT_PRODUCTS (packages/engine/src/billing/plans.ts);
# a code with no price id is refused at checkout naming the variable to set.
# Free needs none, and Enterprise is agreed rather than bought.
# STRIPE_PRICE_SOLO=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# STRIPE_PRICE_CREDITS_10=price_...
# STRIPE_PRICE_CREDITS_30=price_...
# STRIPE_PRICE_CREDITS_80=price_...
# Absolute origin that checkout return URLs are built from. Leave it unset and
# the request's own origin is used (Host, plus X-Forwarded-Proto when a proxy
# sets it), which is correct for a plain single-host deployment. Set it when the
# host the customer is on is not the host that reaches this process — behind a
# proxy that rewrites Host, or on a custom domain — because a return URL has to
# land back where they started. A value that is not an absolute http/https
# origin is refused at checkout, naming this variable.
# CODELENS_PUBLIC_URL=https://codelens.example.com
